{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nemawashi: Interactive CLI Demo",
      "type": "debugpy",
      "request": "launch",
      "module": "nemawashi.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Nemawashi: Run All Pytests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}

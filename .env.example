# Gemini API Key for Live Multi-Agent Deliberation
# If left blank, the engine automatically falls back to deterministic offline simulation
GEMINI_API_KEY=

# Governance Engine Configuration
NEMAWASHI_MAX_ROUNDS=3
NEMAWASHI_AUDIT_LOG_DIR=audit_logs
NEMAWASHI_CACHE_DIR=cache
NEMAWASHI_STATE_DIR=storage

# Cryptographic HITL Callback Webhook Secret (HMAC-SHA256)
NEMAWASHI_WEBHOOK_SECRET=change-me-in-production-32-byte-secret
